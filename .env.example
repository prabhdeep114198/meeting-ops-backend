# ==============================================================================
# MeetingOps Environment Variables Template (.env.example)
# Copy this file to .env and supply your local or production credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/meeting_ops
DB_NAME=meeting_ops
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here

# Service Ports & Networking
SERVER_PORT=8080
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MCP_SERVER_URL=http://localhost:8084/mcp

# AI / LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2

# Security & OAuth2 (Optional / Mock)
OAUTH2_ISSUER_URI=https://auth.meetingops.example.com
OAUTH2_JWK_URI=https://auth.meetingops.example.com/.well-known/jwks.json
